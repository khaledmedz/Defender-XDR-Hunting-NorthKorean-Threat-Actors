// Step 1 — I started by looking for the suspicious DLLs dropped during the tank game
FileCreationEvents
| where filename in~ ("nvunityplugin.dll", "unityplayer.dll")
| distinct sha256

// Step 2 — This was the smoking gun: I found the FTP exfiltration command
ProcessEvents
| where process_commandline has "curl"
| where process_commandline has_any ("mingeloem.com", "matrixane.com")

// Step 3 — I checked what was inside the zip file they were trying to steal
ProcessEvents
| where process_commandline has "TopSecret.zip"

// Step 4 — I traced where the data originally came from
ProcessEvents
| where process_commandline has "StagingArea"

// Step 5 — Finally, I identified which employee was the source of the exfiltration
Email
| where subject contains "logs.zip"
